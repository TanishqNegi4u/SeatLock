# ==============================================================================
# SeatLock — Kubernetes Secret Template (DO NOT COMMIT SENSITIVE VALUES)
# Copy this file to `secret.yaml` and set production/local credentials:
#   cp k8s/secret.yaml.example k8s/secret.yaml
#
# Alternatively, create directly via kubectl:
#   kubectl create secret generic seatlock-secret \
#     --from-literal=SPRING_DATASOURCE_USERNAME=seatlock \
#     --from-literal=SPRING_DATASOURCE_PASSWORD=your_secure_password \
#     --from-literal=POSTGRES_USER=seatlock \
#     --from-literal=POSTGRES_PASSWORD=your_secure_password \
#     --from-literal=POSTGRES_DB=seatlock
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: seatlock-secret
type: Opaque
stringData:
  SPRING_DATASOURCE_USERNAME: "seatlock"
  SPRING_DATASOURCE_PASSWORD: "CHANGE_ME_IN_PRODUCTION"
  POSTGRES_USER: "seatlock"
  POSTGRES_PASSWORD: "CHANGE_ME_IN_PRODUCTION"
  POSTGRES_DB: "seatlock"
